# Copiar este archivo a ".env" y completar los valores.
# ".env" NO se sube al repo (está en .gitignore).

# Conexión a la base de datos.
# Local (Docker): usa el usuario/clave/base del docker-compose.yml
# Nota: el contenedor se publica en el puerto 5433 (ver docker-compose.yml).
DATABASE_URL=postgresql+psycopg2://club:clubpass@localhost:5433/clubdb

# Credenciales de Firebase Admin SDK (verificación de tokens y registro de usuarios).
# Local: ruta al JSON descargado de Firebase > Configuración del proyecto >
#        Cuentas de servicio > Generar nueva clave privada. Ese archivo NO se sube.
# Render: pegar el contenido completo del JSON como variable de entorno secreta.
FIREBASE_CREDENTIALS=nombre-del-proyecto-firebase-adminsdk-xxxxx.json

# Clave secreta de las tareas programadas (recordatorios de reservas). La manda el
# cron de GitHub Actions en el header X-Tareas-Clave. Generar una larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vacía = POST /tareas/recordatorios rechaza todos los pedidos.
TAREAS_CLAVE=

# Entorno: development | production
ENVIRONMENT=development
